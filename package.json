{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node -r ./tsconfig-paths-bootstrap.js src/server.ts",
    "build": "npm run clean && npm run generate && tsc",
    "start": "node -r ./tsconfig-paths-bootstrap.js dist/server.js",
    "start:with-migrate": "npm run migrate:deploy && npm run start",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "redis": "^4.7.0",
    "socket.io": "^4.7.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.11.16",
    "@types/redis": "^4.0.10",
    "@types/socket.io": "^3.0.2",
    "nodemon": "^3.1.9",
    "prisma": "^5.10.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
