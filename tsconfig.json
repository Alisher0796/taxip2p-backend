{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "baseUrl": "./src",
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "paths": {
      "@lib/*": ["lib/*"],
      "@types/*": ["types/*"],
      "@features/*": ["features/*"],
      "@middleware/*": ["middleware/*"],
      "@config/*": ["config/*"],
      "@validators/*": ["validators/*"]
    }
  },
  "include": ["src"]
}
