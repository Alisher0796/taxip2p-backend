# Основные настройки
NODE_ENV=development
PORT=5001
CLIENT_URL=https://taxip2p-frontend.vercel.app

# База данных
DATABASE_URL=postgresql://postgres:password@localhost:5432/taxip2p

# Telegram Bot
BOT_TOKEN=your_bot_token_here

# Безопасность
RATE_LIMIT_WINDOW_MS=900000  # 15 минут
RATE_LIMIT_MAX_REQUESTS=100   # Максимум запросов в окно
TELEGRAM_AUTH_TTL=86400000   # 24 часа в миллисекундах

# WebSocket
WS_PING_TIMEOUT=60000         # 60 секунд
WS_PING_INTERVAL=25000        # 25 секунд
WS_MAX_BUFFER_SIZE=1000000    # 1MB в байтах

# Заказы
ORDER_DAILY_LIMIT=10          # Максимум заказов в день
ORDER_OFFER_TIMEOUT=300000    # 5 минут на принятие предложения
ORDER_MAX_ACTIVE=3            # Максимум активных заказов
ORDER_MAX_OFFERS=5            # Максимум предложений на заказ
ORDER_MIN_PRICE=500           # Минимальная цена в KZT
ORDER_MAX_PRICE=50000         # Максимальная цена в KZT
ORDER_CACHE_TTL=30000         # 30 секунд кэширования
ORDER_CACHE_SIZE=1000         # Максимум заказов в кэше